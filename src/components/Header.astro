---
import { sectionLabels, type Locale } from '../data/site';

interface Props {
  locale: Locale;
  name: { en: string; th: string };
}

const { locale, name: localizedName } = Astro.props;
const name = localizedName[locale];
const labels = sectionLabels[locale];
const otherLocale: Locale = locale === 'en' ? 'th' : 'en';
const baseUrl = `${import.meta.env.BASE_URL}/`;
---

<header class="sticky top-0 z-10 border-b border-[oklch(0.87_0.012_255_/_0.82)] bg-[oklch(0.975_0.004_250_/_0.93)] backdrop-blur-xl">
  <div class="mx-auto flex min-h-16 max-w-[1180px] flex-wrap items-center justify-between gap-3 px-5 sm:px-7">
    <a class="flex items-center gap-3 whitespace-nowrap font-mono text-[13px] font-medium tracking-[.02em] no-underline" href={`${baseUrl}${locale}/`}>
      <b class="grid size-[26px] place-items-center rounded-[7px] border border-current text-[11px]">{name.slice(0, 2).toUpperCase()}</b>
      <span>{name}</span>
    </a>
    <nav class="order-3 w-full overflow-x-auto pb-2 sm:order-none sm:w-auto sm:pb-0" aria-label="Primary navigation">
      <ul class="flex w-max items-center gap-1 text-[11px] font-medium tracking-[.02em] text-[oklch(0.51_0.018_255)] sm:w-auto">
        <li><a class="block px-2 py-2 hover:text-[oklch(0.205_0.012_255)]" href={`${baseUrl}${locale}/#about`}>{labels.about}</a></li>
        <li><a class="block px-2 py-2 hover:text-[oklch(0.205_0.012_255)]" href={`${baseUrl}${locale}/#projects`}>{labels.projects}</a></li>
        <li><a class="block px-2 py-2 hover:text-[oklch(0.205_0.012_255)]" href={`${baseUrl}${locale}/#experiences`}>{labels.experiences}</a></li>
        <li><a class="block px-2 py-2 hover:text-[oklch(0.205_0.012_255)]" href={`${baseUrl}${locale}/#skills`}>{labels.skills}</a></li>
      </ul>
    </nav>
    <a class="rounded-lg border border-[oklch(0.87_0.012_255)] px-3 py-1.5 font-mono text-[11px] font-medium" href={`${baseUrl}${otherLocale}/`} lang={otherLocale}>
      {otherLocale.toUpperCase()}
    </a>
  </div>
</header>
